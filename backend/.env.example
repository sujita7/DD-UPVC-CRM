# DD UPVC CRM & ERP Backend Configuration
# Copy this file to .env and adjust values for your environment

# Server
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=crm_db

# JWT Security
JWT_SECRET=dd_upvc_crm_jwt_super_secret_key_min_32_chars_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dd_upvc_crm_jwt_refresh_secret_key_32_chars_2026
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Session Security
COOKIE_SECRET=dd_upvc_crm_cookie_secret_key

# CORS - Frontend Client URL
CLIENT_URL=http://localhost:3000

# Email (SMTP - Optional, for PDF emailing and dispatch notices)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ddupvcwindowsystem@gmail.com
SMTP_PASS=your_app_specific_password

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
